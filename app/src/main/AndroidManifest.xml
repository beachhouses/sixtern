<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sixtern">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Sixtern.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.auth.StudentRegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.home.StudentHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.auth.MentorHomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.MentorRegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.logbook.LogbookActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.logbook.LogbookFormActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.evaluation.EvaluationActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

    </application>

</manifest>
