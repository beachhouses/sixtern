<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sixtern">

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Sixtern.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.auth.StudentRegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.home.StudentHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.home.CompanyDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.profile.MapPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.auth.MentorHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.profile.MentorProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.auth.MentorRegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.logbook.LogbookActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.logbook.LogbookFormActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.evaluation.EvaluationActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.notification.MentorNotificationActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />


        <activity
            android:name=".ui.applicant.ApplicantDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.profile.StudentProfileEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.notification.StudentNotificationActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.participants.MentorParticipantsActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.prodi.ProdiHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.prodi.ProdiVerificationActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.prodi.ProdiProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.attendance.AttendanceReportActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <activity
            android:name=".ui.logbook.LogbookReviewDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Sixtern.Login" />

        <!-- Berbagi file PDF sementara (surat permohonan) ke viewer eksternal. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>

</manifest>
