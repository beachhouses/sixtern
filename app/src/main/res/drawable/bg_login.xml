<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base terang -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/login_bg" />
        </shape>
    </item>
    <!-- Aksen hijau kanan atas (badge daun mockup) -->
    <item
        android:left="250dp"
        android:top="-60dp"
        android:right="-100dp"
        android:bottom="480dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#3D10B981"
                android:centerColor="#1A10B981"
                android:endColor="#0010B981" />
        </shape>
    </item>
</layer-list>
