<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="← Kembali"
            android:textColor="@color/login_button"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/logbook_form_title"
            android:textColor="@color/login_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/logbook_subtitle"
            android:textColor="@color/login_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_login_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logbook_title_hint"
                android:textColor="@color/login_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_login_input"
                android:hint="@string/logbook_title_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/login_text_primary"
                android:textColorHint="@color/login_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/logbook_desc_label"
                android:textColor="@color/login_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Toolbar format ala Word: baris 1 gaya huruf, baris 2 warna -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/boldButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="B"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/login_input_stroke"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/italicButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="I"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textStyle="italic"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/login_input_stroke"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/underlineButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="U"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/login_input_stroke"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/bulletButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="• ≡"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/login_input_stroke"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/clearFormatButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:text="⌫"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/login_input_stroke"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/colorRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <EditText
                android:id="@+id/descInput"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_login_input"
                android:gravity="top"
                android:hint="@string/logbook_desc_label"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="@color/login_text_primary"
                android:textColorHint="@color/login_text_secondary"
                android:textSize="14sp" />

            <!-- Sematkan file (gambar/PDF, opsional) -->
            <Button
                android:id="@+id/attachmentButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:text="@string/logbook_attachment_pick_any"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/login_button"
                app:strokeWidth="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/logbook_attachment_hint"
                android:textColor="@color/login_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/attachmentNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/sixtern_green_deep"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Catatan mentor (read-only, hanya tampil saat revisi) -->
            <TextView
                android:id="@+id/mentorNotesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/logbook_form_mentor_notes"
                android:textColor="@color/login_button"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/mentorNotesText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_apply_status"
                android:lineSpacingMultiplier="1.4"
                android:padding="14dp"
                android:textColor="@color/chip_rejected_text"
                android:textSize="13sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loadingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_button"
                android:backgroundTint="@null"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/login_button_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
