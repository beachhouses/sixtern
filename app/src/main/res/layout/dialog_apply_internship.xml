<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/applyDialogDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/login_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/apply_start_date_label"
            android:textColor="@color/login_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startDateButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/apply_start_date_hint"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/login_button"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/apply_end_date_label"
            android:textColor="@color/login_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/endDateButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/apply_end_date_hint"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/login_button"
            app:strokeWidth="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/apply_letter_label"
            android:textColor="@color/login_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/letterFileNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_input"
            android:padding="14dp"
            android:text="@string/apply_letter_empty"
            android:textColor="@color/login_text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/letterPickButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@string/apply_letter_pick"
            android:textAllCaps="false"
            android:textSize="14sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/sixtern_green_deep"
            app:strokeWidth="1dp" />
    </LinearLayout>
</ScrollView>
